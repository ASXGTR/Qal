  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QALInformationPanel
  panelRoot: {fileID: 0}
  infoText: {fileID: 0}
  hoverMessage: "In a real vehicle, the ECU automatically detects when a valid key
    is inside the cabin.\nThis can be done using RF, BLE, UWB, or NFC signals.\nThe
    Activate Key button represents that moment:\n\u2022 The vehicle senses the key
    nearby\n\u2022 The ECU confirms proximity\n\u2022 The system prepares for secure
    authentication\nThis is the first step before any digital key or ultrasonic token
    validation."
